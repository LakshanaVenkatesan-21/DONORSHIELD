# Copy this file to .env and fill in values for your environment.
# .env is excluded from version control by .gitignore.

# ---------------------------------------------------------------------------
# Flask session secret
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# AES-256-GCM encryption key (Stage 2)
#
# Must be a 64-character lowercase hex string representing 32 bytes.
# Generate in PowerShell with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Set the variable for the current PowerShell session:
#   $env:DS_AES_KEY = "paste-64-char-hex-here"
#
# Or add it permanently to your user environment:
#   [System.Environment]::SetEnvironmentVariable("DS_AES_KEY","paste-64-char-hex-here","User")
#
# NEVER commit the real key to version control.
# NEVER log this value or include it in HTTP responses.
# If the key is lost, encrypted data cannot be recovered.
# ---------------------------------------------------------------------------
DS_AES_KEY=replace-with-64-char-hex-string

# ---------------------------------------------------------------------------
# Cookie security
# Set to "true" only when running behind HTTPS (production).
# Leave as "false" for local HTTP development.
# ---------------------------------------------------------------------------
SESSION_COOKIE_SECURE=false

# Override the SQLite database path (optional).
# DB_PATH=/path/to/donorshield.db

# Used internally by the pytest fixture — do not set manually.
# TESTING=false

# ---------------------------------------------------------------------------
# RSA signing key paths (Stage 4)
#
# Generate the key pair once with:
#   $env:FLASK_APP = "app.py"
#   flask generate-keys
#
# This creates keys/private.pem and keys/public.pem in the project root.
# keys/private.pem is excluded from version control by .gitignore.
#
# Override the default paths if you store keys elsewhere:
#   DS_RSA_PRIVATE_KEY_PATH=C:\path\to\private.pem
#   DS_RSA_PUBLIC_KEY_PATH=C:\path\to\public.pem
#
# NEVER commit private.pem to version control.
# NEVER log or display its contents.
# ---------------------------------------------------------------------------
# DS_RSA_PRIVATE_KEY_PATH=keys/private.pem
# DS_RSA_PUBLIC_KEY_PATH=keys/public.pem

# ---------------------------------------------------------------------------
# CSRF protection (Stage 7)
#
# Flask-WTF CSRF is enabled by default (WTF_CSRF_ENABLED=true).
# Set to "false" ONLY in automated test environments that manage CSRF tokens
# explicitly. Never disable in production.
# ---------------------------------------------------------------------------
# WTF_CSRF_ENABLED=true
